{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === 'DDyGDGEC8iVygEgaUl2MoHemWnH2' && !newData.exists()",
        "name": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 12 && !newData.val().matches(/[.$#\\[\\]\\/]/) && newData.parent().parent().parent().child('names').child(newData.val().toLowerCase()).val() === $uid"
        },
        "progress": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === 'DDyGDGEC8iVygEgaUl2MoHemWnH2')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
        },
        "secured": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        },
        "$other": { ".validate": false }
      }
    },
    "names": {
      ".read": true,
      "$key": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && newData.parent().parent().child('players').child(auth.uid).child('name').val().toLowerCase() === $key) || (auth.uid === 'DDyGDGEC8iVygEgaUl2MoHemWnH2' && !newData.exists()))"
      }
    },
    "released": {
      ".read": true,
      "$key": {
        ".write": "auth != null && (auth.uid === 'DDyGDGEC8iVygEgaUl2MoHemWnH2' || (!newData.exists() && root.child('names').child($key).val() === auth.uid))",
        ".validate": "newData.hasChildren(['score', 'progress']) && newData.child('score').isNumber() && newData.child('progress').isNumber() && newData.child('progress').val() >= 0 && newData.child('progress').val() <= 15",
        "score": { ".validate": true },
        "progress": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "scores": {
      ".read": true,
      ".indexOn": ["score"],
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && newData.exists() && (!data.exists() || newData.child('score').val() > data.child('score').val())) || auth.uid === 'DDyGDGEC8iVygEgaUl2MoHemWnH2')",
        ".validate": "newData.hasChildren(['name', 'score']) && newData.child('name').val() === newData.parent().parent().child('players').child($uid).child('name').val() && newData.child('score').isNumber() && newData.child('score').val() > 0 && newData.child('score').val() < 1000000",
        "name": { ".validate": true },
        "score": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
