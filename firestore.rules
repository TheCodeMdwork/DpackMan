rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(d) {
      return d.keys().hasAll(['name', 'score']) && d.keys().hasOnly(['name', 'score'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 12
        && d.score is int && d.score > 0 && d.score < 1000000;
    }
    // One document per player; a score can only go up.
    match /scores/{playerId} {
      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow update: if validScore(request.resource.data) && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
